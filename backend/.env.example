# ── Google OAuth (Gmail API) ──────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Your Netlify URL + callback path (MUST match Google Console exactly)
GMAIL_REDIRECT_URI=https://your-app.netlify.app/auth/gmail/callback

# ── Supabase ──────────────────────────────────────────────────
# Same URL as frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
# SERVICE KEY (not anon key) — has admin access, never expose to frontend
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── App ───────────────────────────────────────────────────────
# Your Netlify frontend URL
FRONTEND_URL=https://your-app.netlify.app
SESSION_SECRET=change-this-to-a-random-string-in-production
NODE_ENV=production
PORT=3001
